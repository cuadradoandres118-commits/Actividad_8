        "# Actividad 8. Códigos SQL de AgroDatos\n",
        "\n",
        "## 1. Ejercicio 1. Modificar la base de datos\n",
        "\n",
        "### 1.1. Agregar el tipo de riego a la tabla `lote`\n",
        "\n",
        "```sql\n",
        "ALTER TABLE lote\n",
        "ADD COLUMN tipo_riego ENUM(\n",
        "    'goteo',\n",
        "    'aspersión',\n",
        "    'gravedad',\n",
        "    'secano'\n",
        ") NOT NULL DEFAULT 'secano';\n",
        "```\n",
        "\n",
        "### 1.2. Crear la tabla `operario`\n",
        "\n",
        "```sql\n",
        "CREATE TABLE operario (\n",
        "    id_operario INT AUTO_INCREMENT PRIMARY KEY,\n",
        "    documento VARCHAR(20) NOT NULL UNIQUE,\n",
        "    nombre_completo VARCHAR(100) NOT NULL,\n",
        "    telefono VARCHAR(20),\n",
        "    certificado_aplicador BOOLEAN NOT NULL DEFAULT FALSE\n",
        ");\n",
        "```\n",
        "\n",
        "### 1.3. Insertar los operarios\n",
        "\n",
        "```sql\n",
        "INSERT INTO operario (\n",
        "    documento,\n",
        "    nombre_completo,\n",
        "    telefono,\n",
        "    certificado_aplicador\n",
        ")\n",
        "VALUES\n",
        "('1012', 'Jorge Patiño', '3101112233', TRUE),\n",
        "('2045', 'Luz Marina Ortiz', '3125556677', TRUE),\n",
        "('3090', 'Ramiro Suárez', '3009998877', FALSE);\n",
        "```\n",
        "\n",
        "## 2. Ejercicio 2. Productos y aplicaciones\n",
        "\n",
        "### 2.1. Insertar los productos faltantes\n",
        "\n",
        "```sql\n",
        "INSERT INTO producto (\n",
        "    nombre_comercial,\n",
        "    tipo,\n",
        "    ingrediente_activo,\n",
        "    categoria_tox,\n",
        "    registro_ica,\n",
        "    dosis_ha,\n",
        "    unidad,\n",
        "    carencia_dias,\n",
        "    reingreso_horas,\n",
        "    precio_unidad\n",
        ")\n",
        "VALUES\n",
        "(\n",
        "    'BioLarva WP',\n",
        "    'bioinsumo',\n",
        "    'Bacillus thuringiensis var. kurstaki',\n",
        "    'IV',\n",
        "    'ICA-DEMO-2001',\n",
        "    0.5,\n",
        "    'kg',\n",
        "    0,\n",
        "    4,\n",
        "    95000\n",
        "),\n",
        "(\n",
        "    'RoyaStop 250 EC',\n",
        "    'fungicida',\n",
        "    'Triazol 250 g/L',\n",
        "    'III',\n",
        "    'ICA-DEMO-3001',\n",
        "    0.4,\n",
        "    'L',\n",
        "    30,\n",
        "    24,\n",
        "    160000\n",
        "),\n",
        "(\n",
        "    'TizónFin 80 WP',\n",
        "    'fungicida',\n",
        "    'Ditiocarbamato 800 g/kg',\n",
        "    'III',\n",
        "    'ICA-DEMO-3002',\n",
        "    2.5,\n",
        "    'kg',\n",
        "    14,\n",
        "    24,\n",
        "    38000\n",
        ");\n",
        "```\n",
        "\n",
        "### 2.2. Registrar la aplicación en el lote POR-L01\n",
        "\n",
        "```sql\n",
        "INSERT INTO aplicacion (\n",
        "    id_lote,\n",
        "    id_producto,\n",
        "    fecha,\n",
        "    cantidad,\n",
        "    responsable\n",
        ")\n",
        "SELECT\n",
        "    l.id_lote,\n",
        "    p.id_producto,\n",
        "    '2026-10-14',\n",
        "    p.dosis_ha * l.area_ha,\n",
        "    'Estudiante'\n",
        "FROM lote AS l\n",
        "CROSS JOIN producto AS p\n",
        "WHERE l.codigo = 'POR-L01'\n",
        "  AND p.nombre_comercial = 'RoyaStop 250 EC';\n",
        "```\n",
        "\n",
        "### 2.3. Calcular la fecha mínima de cosecha\n",
        "\n",
        "```sql\n",
        "SELECT\n",
        "    a.id_aplicacion,\n",
        "    a.fecha AS fecha_aplicacion,\n",
        "    l.codigo AS lote,\n",
        "    p.nombre_comercial AS producto,\n",
        "    p.carencia_dias,\n",
        "    DATE_ADD(\n",
        "        a.fecha,\n",
        "        INTERVAL p.carencia_dias DAY\n",
        "    ) AS fecha_minima_cosecha\n",
        "FROM aplicacion AS a\n",
        "INNER JOIN lote AS l\n",
        "    ON a.id_lote = l.id_lote\n",
        "INNER JOIN producto AS p\n",
        "    ON a.id_producto = p.id_producto\n",
        "WHERE l.codigo = 'POR-L01'\n",
        "  AND p.nombre_comercial = 'RoyaStop 250 EC';\n",
        "```\n",
        "\n",
        "## 3. Ejercicio 3. Consultas SQL\n",
        "\n",
        "### 3.1. Área total por cultivo\n",
        "\n",
        "```sql\n",
        "SELECT\n",
        "    cultivo,\n",
        "    SUM(area_ha) AS area_total_ha\n",
        "FROM lote\n",
        "GROUP BY cultivo\n",
        "ORDER BY area_total_ha DESC;\n",
        "```\n",
        "\n",
        "### 3.2. Fincas con más de 5.0 hectáreas sembradas\n",
        "\n",
        "```sql\n",
        "SELECT\n",
        "    f.id_finca,\n",
        "    f.nombre AS finca,\n",
        "    SUM(l.area_ha) AS area_total_ha\n",
        "FROM finca AS f\n",
        "INNER JOIN lote AS l\n",
        "    ON f.id_finca = l.id_finca\n",
        "GROUP BY f.id_finca, f.nombre\n",
        "HAVING SUM(l.area_ha) > 5.0\n",
        "ORDER BY area_total_ha DESC;\n",
        "```\n",
        "\n",
        "### 3.3. Productos que nunca se han aplicado\n",
        "\n",
        "```sql\n",
        "SELECT\n",
        "    p.id_producto,\n",
        "    p.nombre_comercial,\n",
        "    p.tipo\n",
        "FROM producto AS p\n",
        "LEFT JOIN aplicacion AS a\n",
        "    ON p.id_producto = a.id_producto\n",
        "WHERE a.id_aplicacion IS NULL;\n",
        "```\n",
        "\n",
        "### 3.4. Responsable que aplicó más kilogramos de fertilizante\n",
        "\n",
        "```sql\n",
        "SELECT\n",
        "    a.responsable,\n",
        "    SUM(a.cantidad) AS kilogramos_aplicados\n",
        "FROM aplicacion AS a\n",
        "INNER JOIN producto AS p\n",
        "    ON a.id_producto = p.id_producto\n",
        "WHERE p.tipo = 'fertilizante'\n",
        "  AND p.unidad = 'kg'\n",
        "GROUP BY a.responsable\n",
        "ORDER BY kilogramos_aplicados DESC\n",
        "LIMIT 1;\n",
        "```\n",
        "\n",
        "## 4. Ejercicio 4. Normalización\n",
        "\n",
        "### 4.1. Crear la tabla `aplicacion_n`\n",
        "\n",
        "```sql\n",
        "CREATE TABLE aplicacion_n (\n",
        "    id_aplicacion_n INT AUTO_INCREMENT PRIMARY KEY,\n",
        "    fecha DATE NOT NULL,\n",
        "    id_lote INT NOT NULL,\n",
        "    id_producto INT NOT NULL,\n",
        "    cantidad DECIMAL(10,2) NOT NULL,\n",
        "    documento_operario VARCHAR(20) NOT NULL,\n",
        "    observaciones VARCHAR(255),\n",
        "\n",
        "    CONSTRAINT fk_aplicacion_n_lote\n",
        "        FOREIGN KEY (id_lote)\n",
        "        REFERENCES lote(id_lote),\n",
        "\n",
        "    CONSTRAINT fk_aplicacion_n_producto\n",
        "        FOREIGN KEY (id_producto)\n",
        "        REFERENCES producto(id_producto),\n",
        "\n",
        "    CONSTRAINT fk_aplicacion_n_operario\n",
        "        FOREIGN KEY (documento_operario)\n",
        "        REFERENCES operario_n(documento)\n",
        ");\n",
        "```\n",
        "\n",
        "### 4.2. Migrar los datos de `planilla_campo`\n",
        "\n",
        "```sql\n",
        "INSERT INTO aplicacion_n (\n",
        "    fecha,\n",
        "    id_lote,\n",
        "    id_producto,\n",
        "    cantidad,\n",
        "    documento_operario,\n",
        "    observaciones\n",
        ")\n",
        "SELECT\n",
        "    pc.fecha,\n",
        "    l.id_lote,\n",
        "    p.id_producto,\n",
        "    pc.cantidad,\n",
        "    pc.documento_operario,\n",
        "    pc.observaciones\n",
        "FROM planilla_campo AS pc\n",
        "INNER JOIN lote AS l\n",
        "    ON pc.codigo_lote = l.codigo\n",
        "INNER JOIN producto AS p\n",
        "    ON pc.producto = p.nombre_comercial\n",
        "INNER JOIN operario_n AS o\n",
        "    ON pc.documento_operario = o.documento;\n",
        "```\n",
        "\n",
        "### 4.3. Consultar los datos normalizados\n",
        "\n",
        "```sql\n",
        "SELECT\n",
        "    a.fecha,\n",
        "    l.codigo AS codigo_lote,\n",
        "    l.cultivo,\n",
        "    p.nombre_comercial AS producto,\n",
        "    p.categoria_tox,\n",
        "    a.cantidad,\n",
        "    o.documento,\n",
        "    o.nombre_completo,\n",
        "    o.telefono,\n",
        "    a.observaciones\n",
        "FROM aplicacion_n AS a\n",
        "INNER JOIN lote AS l\n",
        "    ON a.id_lote = l.id_lote\n",
        "INNER JOIN producto AS p\n",
        "    ON a.id_producto = p.id_producto\n",
        "INNER JOIN operario_n AS o\n",
        "    ON a.documento_operario = o.documento\n",
        "ORDER BY a.fecha;\n",
        "```\n",
        "\n",
        "## 5. Ejercicio 5. Consultas de detecciones YOLO\n",
        "\n",
        "### 5.1. Detecciones de plagas por lote y semana\n",
        "\n",
        "```sql\n",
        "SELECT\n",
        "    lote,\n",
        "    YEARWEEK(fecha_hora, 3) AS anio_semana,\n",
        "    COUNT(*) AS total_detecciones\n",
        "FROM v_deteccion_valida\n",
        "WHERE clase <> 'planta_sana'\n",
        "GROUP BY\n",
        "    lote,\n",
        "    YEARWEEK(fecha_hora, 3)\n",
        "ORDER BY\n",
        "    lote,\n",
        "    anio_semana;\n",
        "```\n",
        "\n",
        "### 5.2. Detecciones por hectárea\n",
        "\n",
        "```sql\n",
        "SELECT\n",
        "    lote,\n",
        "    MAX(area_ha) AS area_ha,\n",
        "    COUNT(*) AS total_detecciones,\n",
        "    ROUND(\n",
        "        COUNT(*) / NULLIF(MAX(area_ha), 0),\n",
        "        2\n",
        "    ) AS detecciones_por_ha\n",
        "FROM v_deteccion_valida\n",
        "WHERE clase <> 'planta_sana'\n",
        "GROUP BY lote\n",
        "ORDER BY detecciones_por_ha DESC;\n",
        "```\n",
        "\n",
        "### 5.3. Comparar los umbrales de confianza de la maleza\n",
        "\n",
        "```sql\n",
        "SELECT\n",
        "    0.30 AS umbral_confianza,\n",
        "    COUNT(*) AS total_detecciones\n",
        "FROM deteccion\n",
        "WHERE clase = 'maleza'\n",
        "  AND confianza >= 0.30\n",
        "\n",
        "UNION ALL\n",
        "\n",
        "SELECT\n",
        "    0.45,\n",
        "    COUNT(*)\n",
        "FROM deteccion\n",
        "WHERE clase = 'maleza'\n",
        "  AND confianza >= 0.45\n",
        "\n",
        "UNION ALL\n",
        "\n",
        "SELECT\n",
        "    0.60,\n",
        "    COUNT(*)\n",
        "FROM deteccion\n",
        "WHERE clase = 'maleza'\n",
        "  AND confianza >= 0.60\n",
        "\n",
        "UNION ALL\n",
        "\n",
        "SELECT\n",
        "    0.75,\n",
        "    COUNT(*)\n",
        "FROM deteccion\n",
        "WHERE clase = 'maleza'\n",
        "  AND confianza >= 0.75;\n",
        "```\n",
        "\n",
        "### 5.4. Crear la tabla para comparar versiones del modelo\n",
        "\n",
        "```sql\n",
        "CREATE TABLE evaluacion_modelo (\n",
        "    id_evaluacion INT AUTO_INCREMENT PRIMARY KEY,\n",
        "    id_imagen INT NOT NULL,\n",
        "    modelo_version VARCHAR(50) NOT NULL,\n",
        "    fecha_ejecucion DATETIME NOT NULL\n",
        "        DEFAULT CURRENT_TIMESTAMP,\n",
        "\n",
        "    CONSTRAINT uq_imagen_modelo\n",
        "        UNIQUE (id_imagen, modelo_version),\n",
        "\n",
        "    CONSTRAINT fk_evaluacion_imagen\n",
        "        FOREIGN KEY (id_imagen)\n",
        "        REFERENCES imagen(id_imagen)\n",
        "        ON DELETE CASCADE\n",
        ");\n",
        "```\n",
        "\n",
        "Agregar la relación a la tabla `deteccion`:\n",
        "\n",
        "```sql\n",
        "ALTER TABLE deteccion\n",
        "ADD COLUMN id_evaluacion INT NULL,\n",
        "ADD CONSTRAINT fk_deteccion_evaluacion\n",
        "    FOREIGN KEY (id_evaluacion)\n",
        "    REFERENCES evaluacion_modelo(id_evaluacion);\n",
        "```\n",
        "\n",
        "## 6. Verificaciones finales\n",
